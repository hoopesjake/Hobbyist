# Public project URL and publishable key (legacy anon key also supported).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact trusted app origin; localhost for development, HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only TMDB API Read Access Token. Never prefix with NEXT_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=

# Server-only contact email identifying Open Library requests. No API key.
OPEN_LIBRARY_CONTACT_EMAIL=
